{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_INSTALL_BINDIR": "."
      }
    },
    {
      "name": "macos-arm64-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_INSTALL_BINDIR": "bin",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4"
      }
    },
    {
      "name": "enable-tests",
      "hidden": true,
      "cacheVariables": {
        "DARKEYE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/debug"
      }
    },
    {
      "name": "windows-msvc-debug-tests",
      "inherits": ["windows-msvc-debug", "enable-tests"],
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/debug-tests"
      }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/release"
      }
    },
    {
      "name": "windows-msvc-release-tests",
      "inherits": ["windows-msvc-release", "enable-tests"],
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/release-tests"
      }
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "macos-arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64-debug-tests",
      "inherits": ["macos-arm64-debug", "enable-tests"]
    },
    {
      "name": "macos-arm64-release",
      "inherits": "macos-arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-release-tests",
      "inherits": ["macos-arm64-release", "enable-tests"]
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc-debug",
      "displayName": "windows-msvc-debug"
    },
    {
      "name": "debug-tests",
      "configurePreset": "windows-msvc-debug-tests",
      "displayName": "windows-msvc-debug-tests"
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "displayName": "windows-msvc-release"
    },
    {
      "name": "release-tests",
      "configurePreset": "windows-msvc-release-tests",
      "displayName": "windows-msvc-release-tests"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-debug-tests",
      "configurePreset": "macos-arm64-debug-tests"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-release-tests",
      "configurePreset": "macos-arm64-release-tests"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-tests",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-debug-tests",
      "displayName": "windows-msvc-debug-tests"
    },
    {
      "name": "release-tests",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-release-tests",
      "displayName": "windows-msvc-release-tests"
    },
    {
      "name": "macos-arm64-debug-tests",
      "inherits": "test-base",
      "configurePreset": "macos-arm64-debug-tests"
    },
    {
      "name": "macos-arm64-release-tests",
      "inherits": "test-base",
      "configurePreset": "macos-arm64-release-tests"
    }
  ]
}
