QWidget {
    background-color: @PAGE_BACKGROUND@;
    color: @TEXT@;
    font-family: "Microsoft YaHei";
    font-size: 14px;
}

/* Keep long option lists anchored to the field and respect maxVisibleItems. */
QComboBox {
    combobox-popup: 0;
}

QListWidget#mainSidebar {
    background-color: @BACKGROUND@;
    border: 0;
    border-right: 1px solid @BORDER@;
    outline: 0;
}

QListWidget#mainSidebar::item {
    padding: 11px 14px;
}

QListWidget#mainSidebar::item:hover {
    background-color: @INPUT_BACKGROUND@;
}

QListWidget#mainSidebar::item:selected {
    background-color: @PRIMARY@;
    color: @TEXT_INVERSE@;
}

QComboBox#themeSelector,
QComboBox#DesignComboBox,
QComboBox#ShelfScopeSelector,
QComboBox#ShelfSortSelector,
QComboBox#DesignMakerSelector,
QComboBox#WorkSortSelector,
QComboBox#PaginationPageSize,
QLineEdit#DesignInput,
QLineEdit#WorkSearchInput,
QTextEdit#DesignTextEdit,
QPlainTextEdit#DesignPlainTextEdit {
    background-color: @BACKGROUND@;
    border: 2px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 8px;
    color: @TEXT@;
    selection-background-color: @PRIMARY@;
}

QComboBox#themeSelector:hover,
QComboBox#DesignComboBox:hover,
QComboBox#ShelfScopeSelector:hover,
QComboBox#ShelfSortSelector:hover,
QComboBox#DesignMakerSelector:hover,
QComboBox#WorkSortSelector:hover,
QComboBox#PaginationPageSize:hover,
QLineEdit#DesignInput:focus,
QLineEdit#WorkSearchInput:focus,
QTextEdit#DesignTextEdit:focus,
QPlainTextEdit#DesignPlainTextEdit:focus {
    border-color: @BORDER_FOCUS@;
    background-color: @INPUT_BACKGROUND@;
}

QComboBox#DesignComboBox,
QComboBox#ShelfScopeSelector,
QComboBox#ShelfSortSelector,
QComboBox#DesignMakerSelector {
    padding-right: 24px;
}

QComboBox#DesignComboBox::drop-down,
QComboBox#DesignMakerSelector::drop-down,
QComboBox#ShelfScopeSelector::drop-down,
QComboBox#ShelfSortSelector::drop-down {
    border: none;
    width: 20px;
    background: transparent;
}

QComboBox#DesignComboBox::down-arrow,
QComboBox#DesignMakerSelector::down-arrow,
QComboBox#ShelfScopeSelector::down-arrow,
QComboBox#ShelfSortSelector::down-arrow {
    image: none;
    width: 16px;
    height: 16px;
}

QComboBox#DesignComboBox:disabled,
QLineEdit#DesignInput:disabled,
QTextEdit#DesignTextEdit:disabled,
QPlainTextEdit#DesignPlainTextEdit:disabled {
    color: @TEXT_DISABLED@;
    background-color: @INPUT_BACKGROUND@;
}

QTextEdit#DesignTextEdit,
QPlainTextEdit#DesignPlainTextEdit {
    padding: 6px 8px;
}

QPushButton#DesignButton,
QPushButton#WorkRefreshButton,
QPushButton#WorkLoadButton,
QPushButton#WorkSaveButton {
    background-color: @BACKGROUND@;
    color: @TEXT@;
    border: 2px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 12px;
}

QPushButton#DesignButton:hover,
QPushButton#WorkRefreshButton:hover,
QPushButton#WorkLoadButton:hover,
QPushButton#WorkSaveButton:hover {
    border-color: @PRIMARY@;
    background-color: @INPUT_BACKGROUND@;
}

QPushButton#DesignButton:pressed,
QPushButton#WorkRefreshButton:pressed,
QPushButton#WorkLoadButton:pressed,
QPushButton#WorkSaveButton:pressed {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#DesignButton:disabled,
QPushButton#WorkRefreshButton:disabled,
QPushButton#WorkLoadButton:disabled,
QPushButton#WorkSaveButton:disabled {
    color: @TEXT_DISABLED@;
    background-color: @INPUT_BACKGROUND@;
}

QPushButton#DesignButton[variant="primary"],
QPushButton#WorkRefreshButton[variant="primary"],
QPushButton#WorkSaveButton[variant="primary"] {
    background-color: @PRIMARY@;
    color: @TEXT_INVERSE@;
    border-color: @PRIMARY@;
}

/* AddWorkTabPage3 mirrors the Python editor's three explicit submit states. */
QPushButton#WorkSaveButton[variant="add"] {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 6px;
}

QPushButton#WorkSaveButton[variant="modify"],
QPushButton#WorkLoadButton[variant="warning"] {
    background-color: #FFA500;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 6px;
}

QPushButton#WorkSaveButton[variant="disabled"] {
    background-color: #999999;
    color: #CCCCCC;
    border: none;
    border-radius: 5px;
    padding: 6px;
}

QPushButton#WorkLoadButton[variant="disabled"] {
    background-color: gray;
    color: darkGray;
}

/* Changed fields in the AddWork editor use the same orange warning frame as
 * the Python implementation.  The property is deliberately local to that
 * editor, so ordinary focused controls keep their theme-specific border. */
QLineEdit#DesignInput[addWorkModified="true"],
QTextEdit#DesignTextEdit[addWorkModified="true"],
QPlainTextEdit#DesignPlainTextEdit[addWorkModified="true"],
QSpinBox#DesignSpinBox[addWorkModified="true"],
QComboBox#DesignComboBox[addWorkModified="true"],
QWidget#WorkCoverDropWidget[addWorkModified="true"],
QWidget#FanartStripWidget[addWorkModified="true"] {
    border: 2px solid #FFA500;
}

QPushButton#DesignIconPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}

QPushButton#DesignIconPushButton:hover {
    background-color: @INPUT_BACKGROUND@;
}

QPushButton#DesignIconPushButton:pressed {
    background-color: @BORDER@;
}

QLabel#DesignAsyncImage {
    background-color: transparent;
    color: @TEXT_PLACEHOLDER@;
}

QLabel#RatingHeart {
    background-color: transparent;
    color: @TEXT_PLACEHOLDER@;
    font-size: 28px;
}

QLabel#RatingHeart[active="true"] {
    color: @PRIMARY@;
}

QLabel#PageHeading,
QLabel#PaginationInfo,
QLabel#DesignToastLabel {
    background-color: transparent;
}

QLabel#DesignLabel,
QLabel#DesignEmptyStateIcon,
QLabel#DesignEmptyStateTitle,
QLabel#DesignEmptyStateDescription {
    background-color: transparent;
    color: @TEXT@;
}

QLabel#DesignLabel[tone="muted"],
QLabel#DesignEmptyStateDescription {
    color: @TEXT_PLACEHOLDER@;
}

QLabel#DesignLabel[tone="inverse"],
QLabel#DesignLabel[tone="onDark"],
QLabel#DesignLabel[tone="onImage"] {
    color: @TEXT_INVERSE@;
}

QCheckBox#DesignCheckBox,
QRadioButton#DesignRadioButton,
QGroupBox#DesignGroupBox {
    color: @TEXT@;
    background-color: transparent;
}

QCheckBox#DesignCheckBox::indicator,
QRadioButton#DesignRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid @BORDER@;
    background-color: @BACKGROUND@;
}

QCheckBox#DesignCheckBox::indicator { border-radius: 4px; }
QRadioButton#DesignRadioButton::indicator { border-radius: 10px; }
QCheckBox#DesignCheckBox::indicator:checked,
QRadioButton#DesignRadioButton::indicator:checked {
    border-color: @PRIMARY@;
    background-color: @PRIMARY@;
}

/* Python's TokenCheckBox represents a selection as a solid theme-colour
 * square.  Suppress the platform checkmark so the C++ control has the same
 * visual language. */
QCheckBox#DesignCheckBox::indicator:checked {
    image: none;
}

QSpinBox#DesignSpinBox {
    background-color: @BACKGROUND@;
    border: 2px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 8px;
    padding-right: 24px;
    color: @TEXT@;
    min-height: 1.2em;
    selection-background-color: @PRIMARY@;
}
QSpinBox#DesignSpinBox:hover {
    border-color: @PRIMARY@;
    background-color: @INPUT_BACKGROUND@;
}
QSpinBox#DesignSpinBox:focus {
    border-color: @BORDER_FOCUS@;
    background-color: @INPUT_BACKGROUND@;
}
QSpinBox#DesignSpinBox:disabled {
    color: @TEXT_DISABLED@;
    background-color: @INPUT_BACKGROUND@;
}
QSpinBox#DesignSpinBox::up-button,
QSpinBox#DesignSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border-left: 2px solid @BORDER@;
    background-color: @INPUT_BACKGROUND@;
}
QSpinBox#DesignSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}
QSpinBox#DesignSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}
QSpinBox#DesignSpinBox::up-button:hover,
QSpinBox#DesignSpinBox::down-button:hover {
    background-color: @PRIMARY@;
    border-left-color: @PRIMARY@;
}
QSpinBox#DesignSpinBox::up-button:pressed,
QSpinBox#DesignSpinBox::down-button:pressed {
    background-color: @PRIMARY_HOVER@;
}
QSpinBox#DesignSpinBox::up-arrow,
QSpinBox#DesignSpinBox::down-arrow {
    image: none;
    width: 12px;
    height: 12px;
}

QGroupBox#DesignGroupBox {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox#DesignGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QTabWidget#DesignTabWidget::pane {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    background-color: @BACKGROUND@;
}
QTabWidget#StatisticsTabs::pane {
    border: none;
    background-color: transparent;
}
QTabBar#DesignTabBar::tab {
    color: @TEXT_PLACEHOLDER@;
    background-color: transparent;
    padding: 8px 14px;
    border-bottom: 2px solid transparent;
}
QTabBar#DesignTabBar::tab:selected {
    color: @PRIMARY@;
    border-bottom-color: @PRIMARY@;
}

/* Match Python's TokenTabWidget in the management page. */
QTabWidget#ManagementTabs > QTabBar {
    background-color: transparent;
    border: none;
}
QTabWidget#ManagementTabs > QTabBar::tab {
    background-color: transparent;
    color: @TEXT_PLACEHOLDER@;
    padding: 5px 0px;
    margin-right: 20px;
    font-size: @FONT_SIZE_MIDDLE@;
    font-family: "@FONT_FAMILY_BASE@";
    border: none;
}
QTabWidget#ManagementTabs > QTabBar::tab:hover {
    color: @TEXT@;
}
QTabWidget#ManagementTabs > QTabBar::tab:selected {
    color: @TEXT@;
    font-weight: bold;
    border-bottom: @BORDER_WIDTH@ solid @PRIMARY@;
}
QTabWidget#ManagementTabs::pane {
    border: none;
    top: -1px;
}

QProgressBar#DesignProgressBar {
    color: @TEXT@;
    background-color: @INPUT_BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    text-align: center;
}
QProgressBar#DesignProgressBar::chunk {
    background-color: @PRIMARY@;
    border-radius: 5px;
}

QPushButton#DesignStateToggleButton,
QPushButton#ShelfRelationGraphSettingsButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
QPushButton#DesignStateToggleButton:hover,
QPushButton#ShelfRelationGraphSettingsButton:hover { background-color: @INPUT_BACKGROUND@; }

QPushButton#DesignChip {
    color: @TEXT@;
    background-color: @INPUT_BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    padding: 3px 10px;
}
QPushButton#DesignChip:hover,
QPushButton#DesignChip:checked {
    color: @TEXT_INVERSE@;
    background-color: @PRIMARY@;
    border-color: @PRIMARY@;
}
QPushButton#DesignChip[tone="success"] { border-color: @SUCCESS@; }
QPushButton#DesignChip[tone="warning"] { border-color: @WARNING@; }
QPushButton#DesignChip[tone="error"] { border-color: @ERROR@; }
QPushButton#DesignChip[tone="info"] { border-color: @INFO@; }

QWidget#DesignEmptyState { background-color: transparent; }
QLabel#DesignEmptyStateIcon {
    color: @TEXT_DISABLED@;
    font-size: 36px;
}
QLabel#DesignEmptyStateTitle {
    font-size: 18px;
    font-weight: 600;
}
QPushButton#DesignEmptyStateAction {
    color: @TEXT_INVERSE@;
    background-color: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    border-radius: 8px;
    padding: 6px 14px;
}

QWidget#TransparentWidget { background-color: transparent; }

QSlider#DesignClickableSlider::groove:horizontal {
    height: 4px;
    background-color: @PAGE_BACKGROUND@;
    border-radius: 2px;
}
QSlider#DesignClickableSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background-color: @PRIMARY@;
    border-radius: 7px;
}
QSlider#DesignClickableSlider::groove:vertical {
    width: 4px;
    background-color: @PAGE_BACKGROUND@;
    border-radius: 2px;
}
QSlider#DesignClickableSlider::handle:vertical {
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    background-color: @PRIMARY@;
    border-radius: 7px;
}

QPushButton#DesignRotateButton,
QPushButton#DesignShakeButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}
QPushButton#DesignRotateButton:hover,
QPushButton#DesignShakeButton:hover {
    background-color: @INPUT_BACKGROUND@;
}

QTableView#DesignTableView,
QTableWidget#DesignTableWidget,
QTreeView#DesignTreeView,
QListView#DesignListView,
QListWidget#DesignListWidget {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    alternate-background-color: @INPUT_BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    gridline-color: @BORDER@;
    selection-color: @TEXT_INVERSE@;
    selection-background-color: @PRIMARY@;
    outline: none;
}
/* Person selectors use compact text rows within the themed list frame. */
QListWidget#DesignListWidget[personSelectorList="true"] {
    background-color: @BACKGROUND@;
    color: @TEXT@;
    border: 2px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: @PRIMARY@;
    outline: none;
}
QListWidget#DesignListWidget[personSelectorList="true"]:focus {
    border-color: @BORDER_FOCUS@;
    background-color: @INPUT_BACKGROUND@;
}
QListWidget#DesignListWidget[personSelectorList="true"]::item {
    padding: 1px 8px;
    color: @TEXT@;
}
QListWidget#DesignListWidget[personSelectorList="true"]::item:selected {
    background-color: @PRIMARY@;
    color: @TEXT_INVERSE@;
}
QListWidget#DesignListWidget[personSelectorList="true"]::item:hover:!selected {
    background-color: @INPUT_BACKGROUND@;
    color: @TEXT@;
}
QListWidget#DesignListWidget[personSelectorList="true"]:disabled {
    background-color: @INPUT_BACKGROUND@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER@;
}
/* Match Python: warn on the selected people list, including while focused. */
QListWidget#DesignListWidget[personSelectedList="true"][addWorkModified="true"] {
    border: 2px solid #FFA500;
}
QHeaderView::section {
    color: @TEXT@;
    background-color: @INPUT_BACKGROUND@;
    border: none;
    border-right: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER@;
    padding: 6px;
}

/* Match Python's path table, including its row numbers and cell editor. */
QTableWidget#DesignTableWidget[pathManagement="true"] {
    border: 2px solid @BORDER@;
    border-radius: 8px;
}
QTableWidget#DesignTableWidget[pathManagement="true"] QHeaderView::section {
    background-color: @PAGE_BACKGROUND@;
    padding: 4px 6px;
}
QTableWidget#DesignTableWidget[pathManagement="true"] QHeaderView::section:vertical {
    color: @TEXT_PLACEHOLDER@;
    border-right: 1px solid @BORDER@;
}
QTableWidget#DesignTableWidget[pathManagement="true"]::item {
    background-color: @BACKGROUND@;
    padding: 4px 6px;
    border: none;
}
QTableWidget#DesignTableWidget[pathManagement="true"]::item:selected {
    background-color: @PRIMARY@;
    color: @TEXT_INVERSE@;
}
QTableWidget#DesignTableWidget[pathManagement="true"]::item:hover:!selected {
    background-color: @INPUT_BACKGROUND@;
    color: @TEXT@;
}
QTableWidget#DesignTableWidget[pathManagement="true"] QLineEdit {
    background-color: @BACKGROUND@;
    color: @TEXT@;
    border: 2px solid @BORDER_FOCUS@;
    border-radius: 8px;
    padding: 4px 6px;
    selection-background-color: @PRIMARY@;
}
QTableWidget#DesignTableWidget[pathManagement="true"] QLineEdit:focus {
    background-color: @INPUT_BACKGROUND@;
}

QKeySequenceEdit#DesignKeySequenceEdit {
    background-color: transparent;
    border: none;
}

QDateTimeEdit#DesignDateTimeEdit,
QLineEdit#DesignKeySequenceEditLineEdit {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    border: 2px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 8px;
}
QLineEdit#DesignKeySequenceEditLineEdit {
    min-height: 1.2em;
    selection-background-color: @PRIMARY@;
}
QLineEdit#DesignKeySequenceEditLineEdit:hover {
    border-color: @PRIMARY@;
    background-color: @INPUT_BACKGROUND@;
}
QLineEdit#DesignKeySequenceEditLineEdit:disabled {
    color: @TEXT_DISABLED@;
    background-color: @INPUT_BACKGROUND@;
}
QLineEdit#DesignKeySequenceEditLineEdit:focus {
    background-color: @INPUT_BACKGROUND@;
}
QDateTimeEdit#DesignDateTimeEdit:focus,
QLineEdit#DesignKeySequenceEditLineEdit:focus {
    border-color: @BORDER_FOCUS@;
}

QToolButton#DesignCollapsibleToggle {
    color: @TEXT@;
    background-color: @PAGE_BACKGROUND@;
    border: none;
    padding: 8px;
    font-weight: 600;
    text-align: left;
}
QToolButton#DesignCollapsibleToggle:checked {
    background-color: @INPUT_BACKGROUND@;
}
QWidget#DesignCollapsibleContent { background-color: transparent; }

QScrollArea#ForceViewSettingsPanel {
    background-color: @BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}
QWidget#ShelfRelationGraphOverlay QScrollArea#ForceViewSettingsPanel {
    border: none;
}
QScrollArea#ForceViewSettingsPanel::viewport,
QScrollArea#ForceViewSettingsPanel > QWidget,
QWidget#ForceViewSettingsContent,
QScrollArea#ForceViewSettingsPanel QWidget {
    background-color: @BACKGROUND@;
}
QScrollArea#ForceViewSettingsPanel QSlider#DesignClickableSlider::groove:horizontal {
    background-color: @PAGE_BACKGROUND@;
}
QScrollArea#ForceViewSettingsPanel QSlider#DesignClickableSlider::handle:horizontal {
    background-color: @PRIMARY@;
}
QScrollArea#ForceViewSettingsPanel QScrollBar:vertical {
    width: 8px;
    background: transparent;
}
QScrollArea#ForceViewSettingsPanel QScrollBar::handle:vertical {
    background-color: @BORDER@;
    border-radius: 4px;
    min-height: 28px;
}
QLabel#DesignColorPicker {
    border: 1px solid @BORDER@;
    border-radius: 3px;
}

QDialog#DesignModalDialog {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}
QLabel#DesignModalTitle {
    color: @TEXT@;
    font-size: 16px;
    font-weight: 700;
}
QLabel#DesignModalMessage { color: @TEXT@; }
QPushButton#DesignModalConfirm,
QPushButton#DesignModalCancel {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 12px;
}
QPushButton#DesignModalConfirm {
    color: @TEXT_INVERSE@;
    background-color: @PRIMARY@;
    border-color: @PRIMARY@;
}
QPushButton#DesignModalConfirm[variant="danger"] {
    background-color: @ERROR@;
    border-color: @ERROR@;
}

QAbstractItemView#DesignCompleterPopup {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    border: 1px solid @BORDER@;
    padding: 4px;
    selection-color: @TEXT_INVERSE@;
    selection-background-color: @PRIMARY@;
}

QWidget#DesignSidebarMenuButton {
    background-color: transparent;
    border-left: 3px solid transparent;
}
QWidget#DesignSidebarMenuButton:hover { background-color: @INPUT_BACKGROUND@; }
QWidget#DesignSidebarMenuButton[selected="true"] {
    background-color: @INPUT_BACKGROUND@;
    border-left-color: @PRIMARY@;
}
QLabel#DesignSidebarMenuText {
    color: @TEXT@;
    background-color: transparent;
    font-size: 14px;
}

/* Keep every scroll-menu surface on the same background. Plain layout widgets
 * and labels must not paint the application's page-grey background over it. */
QWidget#DesignModernScrollMenu,
QScrollArea#DesignScrollMenuArea,
QWidget#DesignScrollMenuViewport,
QWidget#DesignScrollMenuContent,
QWidget[designScrollMenuContent="true"],
QWidget#DesignScrollMenuSection { background-color: @BACKGROUND@; }
QWidget#DesignScrollMenuNavigation { background-color: @BACKGROUND@; }
QWidget#DesignModernScrollMenu .QWidget,
QWidget#DesignModernScrollMenu QLabel,
QWidget#DesignModernScrollMenu QCheckBox { background-color: transparent; }
QFrame#DesignScrollMenuSeparator {
    background-color: @PAGE_BACKGROUND@;
    min-height: 1px;
    max-height: 1px;
    margin: 10px 0;
}
QPushButton#DesignScrollMenuButton {
    color: @TEXT_PLACEHOLDER@;
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    padding: 10px 15px;
}
QPushButton#DesignScrollMenuButton:hover { color: @TEXT@; }
QPushButton#DesignScrollMenuButton:checked {
    color: @PRIMARY@;
    border-bottom-color: @PRIMARY@;
    font-weight: 600;
}
QLabel#DesignScrollMenuTitle {
    color: @TEXT@;
    font-size: 18px;
    font-weight: 600;
}

QFrame#DesignLinkCard {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}
QFrame#DesignLinkCard:hover {
    background-color: @INPUT_BACKGROUND@;
    border-color: @PRIMARY@;
}
QLabel#DesignLinkCardTitle {
    color: @TEXT@;
    background-color: transparent;
    font-weight: 600;
}
QLabel#DesignLinkCardDescription {
    color: @TEXT_PLACEHOLDER@;
    background-color: transparent;
}
QLabel#DesignLinkCardIcon { background-color: transparent; }

QTabBar#VerticalTabBar::tab {
    color: @TEXT@;
    background-color: @BACKGROUND@;
    border: 1px solid @BORDER@;
    padding: 4px;
}
QTabBar#VerticalTabBar::tab:selected {
    color: @TEXT_INVERSE@;
    background-color: @PRIMARY@;
}

QPushButton#DesignButton[variant="primary"]:hover,
QPushButton#DesignButton[variant="primary"]:pressed {
    background-color: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

QScrollBar:vertical {
    background-color: @PAGE_BACKGROUND@;
    width: 10px;
    margin: 0;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: @BORDER@;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px 1px;
}

QScrollBar::handle:vertical:hover { background-color: @PRIMARY@; }
QScrollBar::handle:vertical:pressed { background-color: @PRIMARY_HOVER@; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background-color: @PAGE_BACKGROUND@;
    height: 10px;
    margin: 0;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: @BORDER@;
    border-radius: 4px;
    min-width: 30px;
    margin: 1px 2px;
}

QScrollBar::handle:horizontal:hover { background-color: @PRIMARY@; }
QScrollBar::handle:horizontal:pressed { background-color: @PRIMARY_HOVER@; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }

QScrollArea#DesignLazyScrollArea {
    border: none;
}

QScrollArea#DesignLazyScrollArea QScrollBar:vertical {
    background-color: @PAGE_BACKGROUND@;
    width: 10px;
    border: none;
}

QScrollArea#DesignLazyScrollArea QScrollBar::handle:vertical {
    background-color: @BORDER@;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px 1px;
}

QScrollArea#DesignLazyScrollArea QScrollBar::handle:vertical:hover {
    background-color: @PRIMARY@;
}

QScrollArea#DesignLazyScrollArea QScrollBar::add-line:vertical,
QScrollArea#DesignLazyScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}
